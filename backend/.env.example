# Postgres connection string (Neon in production: use the direct,
# non-pooled connection string, with ?sslmode=require).
DATABASE_URL="postgresql://user:password@localhost:5432/westminster"

# Code people need to create an account. Share it only with the group;
# change it (and redeploy) to stop new sign-ups.
GROUP_INVITE_CODE="troque-este-codigo"

# Secret used to sign login tokens: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=""

HOST="0.0.0.0"
PORT=3000

# Only when deployed behind a proxy/load balancer (Cloud Run): 1
# TRUST_PROXY=1

# Only for the web version: comma-separated allowed origins.
# CORS_ORIGINS="https://westminster.pages.dev"
